rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(t) {
      return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid);
    }
    function isMember(t) {
      return request.auth != null && exists(memberPath(t));
    }
    function hasRole(t, roles) {
      return isMember(t) && get(memberPath(t)).data.role in roles;
    }

    // "Meus tenants": collectionGroup("members") where uid == me
    match /{path=**}/members/{uid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /tenants/{t} {
      allow read: if isMember(t);
      // Criado junto com o membro owner, no mesmo batch
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(memberPath(t)).data.role == 'owner';
      allow update: if hasRole(t, ['owner', 'admin'])
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if hasRole(t, ['owner']);

      match /members/{uid} {
        allow read: if isMember(t);
        // Bootstrap do owner na criação do tenant
        allow create: if request.auth != null && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'owner'
          && !exists(/databases/$(database)/documents/tenants/$(t))
          && getAfter(/databases/$(database)/documents/tenants/$(t)).data.ownerId == uid;
        allow create: if hasRole(t, ['owner', 'admin'])
          && request.resource.data.uid == uid
          && request.resource.data.role in ['admin', 'member'];
        allow update: if hasRole(t, ['owner', 'admin'])
          && resource.data.role != 'owner'
          && request.resource.data.uid == uid
          && request.resource.data.role in ['admin', 'member'];
        allow delete: if hasRole(t, ['owner', 'admin']) && resource.data.role != 'owner';
      }

      // Agendamentos são criados e remarcados só pelo servidor (Admin SDK).
      // No painel apenas o status muda, sempre com um registro novo no histórico no mesmo batch.
      // Não há delete: o histórico de tudo fica guardado.
      match /appointments/{a} {
        allow read: if isMember(t);
        allow update: if isMember(t)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastHistoryId'])
          && resource.data.status in ['booked', 'confirmed']
          && request.resource.data.status in ['confirmed', 'cancelled', 'no_show']
          && request.resource.data.status != resource.data.status
          && !exists(/databases/$(database)/documents/tenants/$(t)/history/$(request.resource.data.lastHistoryId))
          && getAfter(/databases/$(database)/documents/tenants/$(t)/history/$(request.resource.data.lastHistoryId)).data.appointmentId == a;
      }

      // Histórico: membros leem e criam; ninguém edita ou apaga
      match /history/{h} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.keys().hasOnly(['appointmentId', 'type', 'at', 'by', 'byName'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName == request.auth.token.email
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/tenants/$(t)/appointments/$(request.resource.data.appointmentId)).data.lastHistoryId == h
          && getAfter(/databases/$(database)/documents/tenants/$(t)/appointments/$(request.resource.data.appointmentId)).data.status == request.resource.data.type;
      }

      // Clientes e planos recorrentes: gravados só pelo servidor
      match /customers/{c} {
        allow read: if isMember(t);
      }
      match /plans/{p} {
        allow read: if isMember(t);
      }

      // Qualquer outra coleção do tenant: só membros
      match /{collection}/{doc=**} {
        allow read, write: if !(collection in ['members', 'appointments', 'history', 'customers', 'plans']) && isMember(t);
      }
    }
  }
}
