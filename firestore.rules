rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(t) {
      return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid);
    }
    // Quem administra a plataforma dá suporte em qualquer espaço. A lista fica em
    // config/admin, que nenhuma regra expõe: só o Admin SDK escreve nela.
    function ehAdminPlataforma() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/config/admin).data.uids
        && naoRevogado();
    }
    // "Encerrar sessões" grava revogados[uid] (ms): o servidor já recusa na hora, e a regra também,
    // senão o token emitido antes valia até uma hora lendo pelo SDK do navegador. Vale para todos
    // (a conta da Ruphus é membro de verdade de milhares de espaços e passava pelo exists)
    function naoRevogado() {
      let r = get(/databases/$(database)/documents/config/admin).data.get('revogados', {});
      return !(request.auth.uid in r) || request.auth.token.get('auth_time', 0) * 1000 > r[request.auth.uid];
    }
    function isMember(t) {
      return request.auth != null && naoRevogado() && (exists(memberPath(t)) || ehAdminPlataforma());
    }
    // A demonstração tem senha compartilhada: nome de serviço e de profissional aparece no site, na
    // bio e no agendamento públicos — virava isca de golpe até a restauração. Lá, quem não é da
    // plataforma muda só preço, duração, ativo, horários e quem faz o quê.
    function demoProtegida(t) {
      return t == 'barbearia-force' && !ehAdminPlataforma();
    }
    function hasRole(t, roles) {
      return isMember(t) && get(memberPath(t)).data.role in roles;
    }
    // Quem gere: dono, admin do negócio ou da plataforma. O funcionário ("member",
    // convite da equipe) lê a agenda e o cadastro, mas não muda preço, equipe nem site.
    function gere(t) {
      return ehAdminPlataforma() || hasRole(t, ['owner', 'admin']);
    }
    // texto até max caracteres
    function textoAte(v, max) {
      return v is string && v.size() <= max;
    }
    // a etiqueta i (se existir) é texto curto: regra não tem laço, então uma por índice (até 8)
    function etiquetaOk(l, i) {
      return l.size() <= i || textoAte(l[i], 40);
    }
    // A conta da equipe presa a um profissional (convite dele) vê a agenda toda, mas só
    // muda o status dos horários dele. Membro sem profissional segue como antes.
    function mexeNoHorario(t, staffId) {
      return gere(t) || get(memberPath(t)).data.get('staffId', null) in [null, staffId];
    }

    // Minutos de inatividade até o logout automático: qualquer pessoa logada
    // precisa ler (o painel aplica a regra), e só o servidor escreve.
    match /config/sessao {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mensagens pré-pagas (preço, saldo, pacotes): só o admin da plataforma lê; grava pelo servidor.
    // A tela do dono recebe o preço pelo servidor, não lê config.
    match /config/mensagens {
      allow read: if ehAdminPlataforma();
      allow write: if false;
    }

    // Biblioteca de variantes da prospecção (F4): texto e números só pelo servidor (aba Prospecção do
    // admin, com adminAction). Nem o admin da plataforma lê pelo SDK do navegador.
    match /prospeccaoVariantes/{id} {
      allow read, write: if false;
    }

    // "Meus tenants": collectionGroup("members") where uid == me
    match /{path=**}/members/{uid} {
      allow read: if request.auth != null && naoRevogado() && resource.data.uid == request.auth.uid;
    }

    match /tenants/{t} {
      allow read: if isMember(t);
      // Negócio novo só pelo servidor (criarNegocio): é lá que vale o limite de
      // negócios por conta, e regra não sabe contar quantos a pessoa já tem
      allow create: if false;
      // Só pelo servidor: o painel salva por salvarNegocioAction (validado), e site.*,
      // gerado.* e whatsapp.* alimentam o HTML público, a cobrança e o gateway
      allow update: if false;
      // Sem delete pelo app: as subcoleções ficariam órfãs e o slug poderia ser recriado por outra pessoa
      allow delete: if false;

      match /members/{uid} {
        // a equipe vê só o próprio acesso: a lista (e-mails de todos) é de quem gere
        allow read: if gere(t) || (isMember(t) && uid == request.auth.uid);
        // Convite, papel e saída passam pelo servidor (Admin SDK); o painel não grava aqui
        allow write: if false;
      }

      // Agendamentos são criados e remarcados só pelo servidor (Admin SDK).
      // No painel apenas o status muda, sempre com um registro novo no histórico no mesmo batch.
      // Não há delete: o histórico de tudo fica guardado.
      match /appointments/{a} {
        allow read: if isMember(t);
        allow update: if isMember(t)
          && mexeNoHorario(t, resource.data.staffId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastHistoryId'])
          && resource.data.status in ['booked', 'confirmed']
          && request.resource.data.status in ['confirmed', 'cancelled', 'no_show']
          && request.resource.data.status != resource.data.status
          // recebido no Caixa não se cancela nem vira falta: o dinheiro ficaria contando
          && (request.resource.data.status == 'confirmed' || !exists(/databases/$(database)/documents/tenants/$(t)/lancamentos/$('ag-' + a)))
          && !exists(/databases/$(database)/documents/tenants/$(t)/history/$(request.resource.data.lastHistoryId))
          && getAfter(/databases/$(database)/documents/tenants/$(t)/history/$(request.resource.data.lastHistoryId)).data.appointmentId == a;
      }

      // Histórico: membros leem e criam; ninguém edita ou apaga
      match /history/{h} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.keys().hasOnly(['appointmentId', 'type', 'at', 'by', 'byName'])
          && request.resource.data.by == request.auth.uid
          // autor por e-mail só confirmado: qualquer um cria conta com o e-mail alheio
          && request.resource.data.byName == (request.auth.token.get('email_verified', false) == true ? request.auth.token.email : null)
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/tenants/$(t)/appointments/$(request.resource.data.appointmentId)).data.lastHistoryId == h
          && getAfter(/databases/$(database)/documents/tenants/$(t)/appointments/$(request.resource.data.appointmentId)).data.status == request.resource.data.type;
      }

      // Contadores anti-abuso: nem leitura nem escrita pelo app

      // Clientes e planos recorrentes: gravados só pelo servidor
      match /customers/{c} {
        allow read: if isMember(t);
        // Nome e telefone continuam so do servidor: o cliente os digitou ao
        // agendar, e qualquer um que saiba o telefone consegue agendar. O que o
        // dono escreve *sobre* o cliente — etiquetas e o opt-out de campanha —
        // e dele, e ele edita direto.
        allow update: if isMember(t)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["etiquetas", "semCampanha"])
          && (!("semCampanha" in request.resource.data) || request.resource.data.semCampanha is bool)
          && (
            !("etiquetas" in request.resource.data)
            || (request.resource.data.etiquetas is list && request.resource.data.etiquetas.size() <= 8
              && etiquetaOk(request.resource.data.etiquetas, 0) && etiquetaOk(request.resource.data.etiquetas, 1)
              && etiquetaOk(request.resource.data.etiquetas, 2) && etiquetaOk(request.resource.data.etiquetas, 3)
              && etiquetaOk(request.resource.data.etiquetas, 4) && etiquetaOk(request.resource.data.etiquetas, 5)
              && etiquetaOk(request.resource.data.etiquetas, 6) && etiquetaOk(request.resource.data.etiquetas, 7))
          );

        // Anotacoes seguem o molde de history: o membro escreve, as regras
        // cravam quem escreveu e quando, e ninguem edita depois.
        match /notas/{n} {
          allow read: if isMember(t);
          allow create: if isMember(t)
            && request.resource.data.keys().hasOnly(["texto", "quando", "por", "porNome"])
            && request.resource.data.por == request.auth.uid
            && request.resource.data.porNome == (request.auth.token.get('email_verified', false) == true ? request.auth.token.email : null)
            && request.resource.data.quando == request.time
            && request.resource.data.texto is string
            && request.resource.data.texto.size() > 0
            && request.resource.data.texto.size() <= 600;
          allow update: if false;
          allow delete: if gere(t);
        }
      }
      match /plans/{p} {
        allow read: if isMember(t);
      }
      // Caixa incluído: dinheiro só para quem gere (o funcionário não vê).
      // Gravar, só o servidor (financeiro.server).
      match /lancamentos/{l} {
        allow read: if ehAdminPlataforma() || hasRole(t, ['owner', 'admin']);
        allow write: if false;
      }
      // contas fixas e comissões (%) do Caixa: mesma porta dos lançamentos
      match /caixa/{c} {
        allow read: if ehAdminPlataforma() || hasRole(t, ['owner', 'admin']);
        allow write: if false;
      }
      // consumo de mensagens (cada envio e o agregado do mês): custo é dinheiro, só quem gere.
      // Grava só o servidor (consumo.server), no envio e no webhook de status
      match /envios/{e} {
        allow read: if gere(t);
        allow write: if false;
      }
      match /consumo/{m} {
        allow read: if gere(t);
        allow write: if false;
      }
      // extrato do saldo de mensagens (recarga, consumo do dia, estorno, ajuste, boas-vindas)
      match /creditos/{c} {
        allow read: if gere(t);
        allow write: if false;
      }

      // Lista fechada, não pega-tudo: coleção nova nasce negada e só entra aqui
      // quando alguém decidir que o funcionário pode mesmo ler e escrever nela.
      // A equipe lê; preço, serviços e site só quem gere.
      match /services/{s} {
        allow read: if isMember(t);
        allow create: if gere(t) && !demoProtegida(t)
          && request.resource.data.keys().hasOnly(['name', 'durationMin', 'priceCents', 'tipoPreco', 'active'])
          && textoAte(request.resource.data.name, 80);
        allow delete: if gere(t) && !demoProtegida(t);
        // o app só muda os campos do formulário (e a ordem); usos e o resto são do servidor
        allow update: if gere(t)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'durationMin', 'priceCents', 'tipoPreco', 'active', 'ordem'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || textoAte(request.resource.data.name, 80))
          && (!demoProtegida(t)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priceCents', 'durationMin', 'active', 'tipoPreco', 'ordem']));
      }
      // tenants/{t}/privado/* (WhatsApp pessoal do dono) e o resto sem match: só o servidor
      // Profissional novo é criado pelo servidor: é lá que o limite do plano é
      // contado, e regra não sabe contar documentos. Excluir também é pelo servidor:
      // leva junto o acesso de quem entrava como esse profissional. Editar segue aqui.
      match /staff/{s} {
        allow read: if isMember(t);
        // o app grava o documento inteiro (setDoc sem merge): createdAt, do servidor, some na edição
        // a regravação inteira (setDoc sem merge) lista todas as chaves; a edição parcial (updateDoc) só as alteradas
        allow update: if gere(t)
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'serviceIds', 'hours', 'active', 'createdAt'])
            || request.resource.data.keys().hasOnly(['name', 'serviceIds', 'hours', 'active', 'createdAt']))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || textoAte(request.resource.data.name, 80))
          && (!("serviceIds" in request.resource.data) || (request.resource.data.serviceIds is list && request.resource.data.serviceIds.size() <= 200))
          && (!("hours" in request.resource.data) || request.resource.data.hours is map)
          && (!demoProtegida(t)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']));
        allow create, delete: if false;
      }
    }
  }
}
