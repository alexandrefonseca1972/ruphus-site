NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Segredo que o cron da VPS manda ao chamar /api/cron/* (deploy/crontab.txt). Só em produção.
# DOMINIO_IP: o IP da VPS, para onde o cliente aponta o domínio próprio.
DOMINIO_IP=
CRON_SECRET=

# As chaves dos serviços abaixo (e-mail, WhatsApp e SMS) também podem ser cadastradas no
# /admin, em Ajustes: o que estiver lá passa na frente deste arquivo.

# Conta da Ruphus que envia as propostas por e-mail. A senha é de app (Google,
# Segurança, Senhas de app), não a senha da conta; exige verificação em duas etapas.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Plataforma de notificações WhatsApp (atendys). Local: http://localhost:3002.
# ATENDYS_ADMIN_KEY provisiona o tenant/instância de cada negócio (só servidor).
# Os webhooks chegam em /api/webhooks/atendys assinados por tenant
# (HMAC-SHA256 em x-atendys-signature; o segredo fica gravado no doc do negócio
# ao conectar — não é mais variável de ambiente).
ATENDYS_BASE_URL=http://localhost:3002
ATENDYS_ADMIN_KEY=

# SMS para os clientes (Comtele, API v2).
COMTELE_API_KEY=

# Para onde vão os alertas do sistema (SMS que falhou). Sem ele, vão para GMAIL_USER.
# Também pode ser cadastrado no /admin, em Ajustes.
ALERTA_EMAIL=

# Endereço do www da Ruphus (https://www.ruphus.site): links de convite e cobrança, renovar cache, og.jpg.
SITE_URL=
# Base pública que o atendys usa para chamar o webhook (/api/webhooks/atendys) e montar links de agendar.
PUBLIC_SITE_URL=
# Endereço do site no navegador (metadataBase do layout); fallback do SITE_URL no servidor.
NEXT_PUBLIC_SITE_URL=
# Segredo do cabeçalho x-ruphus: só o proxy lê /api/desativados e /api/dominios. Obrigatório em produção.
DESATIVADOS_TOKEN=
# JSON da conta de serviço do Firebase (firebase-admin) no servidor e nos scripts.
FIREBASE_SERVICE_ACCOUNT=
# uid que vira dono dos sites gerados pela coleta e pela importação (sem ele, o admin que gerou).
OWNER_UID=
# Par VAPID dos avisos push do painel (web-push). A pública vai para o navegador.
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Instância do atendys do canal oficial da plataforma (padrão: ruphus-plataforma-cloud-teste).
ATENDYS_PLATAFORMA_INSTANCIA=
# 1 depois que a Meta aprovar os templates com botões na WABA do número oficial.
ATENDYS_TEMPLATES_BOTOES=
# 1 depois que a Meta aprovar os templates _v2 (contato do estabelecimento no {{5}} dos avisos ao cliente).
ATENDYS_TEMPLATES_V2=
