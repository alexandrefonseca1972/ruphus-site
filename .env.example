NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Segredo que a Vercel manda ao chamar o cron (/api/cron/demo). Só em produção.
CRON_SECRET=

# Conta da Ruphus que envia as propostas por e-mail. A senha é de app (Google,
# Segurança, Senhas de app), não a senha da conta; exige verificação em duas etapas.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gateway WhatsApp próprio (wtsfy). Local: http://localhost:3000 com a x-api-key
# do gateway. Os webhooks que ele dispara chegam em /api/webhooks/wtsfy assinados
# com este segredo (HMAC-SHA256 do corpo em x-wtsfy-signature).
WTSFY_BASE_URL=http://localhost:3000
WTSFY_API_KEY=
WTSFY_WEBHOOK_SECRET=
