[Unit]
Description=ruphus-site - Next.js
After=network-online.target
Wants=network-online.target

[Service]
User=ruphus
Group=ruphus
WorkingDirectory=/opt/ruphus-site/app
ExecStart=/opt/ruphus-site/app/node_modules/.bin/next start -H localhost -p 3001
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=TZ=America/Sao_Paulo
# memória (antes só no drop-in /etc/systemd/system/ruphus-site.service.d/memoria.conf da VPS):
# heap de 1280 MB e o jemalloc, que devolve memória ao sistema (apt install libjemalloc2)
Environment=NODE_OPTIONS=--max-old-space-size=1280
Environment=LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
# o worker da coleta é o serviço ruphus-coleta: sem botão de ligar pelo admin
Environment=COLETA_SERVICO=1
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ruphus-site/app/.next

[Install]
WantedBy=multi-user.target
