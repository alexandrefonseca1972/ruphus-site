# Trecho do /etc/caddy/Caddyfile da VPS para o ruphus-site (o app escuta em localhost:3001).
# O bloco de opções globais vai no TOPO do Caddyfile (junte com o que já existir lá).
# Depois de editar: caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

{
	# domínio próprio de cliente: certificado só para o que o app aprovar
	on_demand_tls {
		ask http://localhost:3001/api/dominios/tls
	}
}

# O IP de quem chama, para o app contar tentativas de agendamento por aparelho. O CF-Connecting-IP
# só vale quando a conexão vem da Cloudflare (faixas de https://www.cloudflare.com/ips, conferidas
# em 02/11/2026): o IP da VPS é público (os domínios próprios apontam para ele), e quem chama direto
# escreveria qualquer IP nesse cabeçalho. Fora das faixas, vale o IP da conexão.
# Caddy 2.6: sem client_ip_headers, por isso o remote_ip.
(ip-real) {
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# no restart do deploy o app fica alguns segundos sem aceitar conexão: o Caddy espera e tenta de
	# novo em vez de devolver 502 (o pedido não chegou ao app, então repetir é seguro)
	reverse_proxy @cloudflare localhost:3001 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		lb_try_duration 30s
		lb_try_interval 250ms
	}
	reverse_proxy localhost:3001 {
		header_up X-Real-IP {remote_host}
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# A lista de domínios aprovados é só para o on_demand_tls, que pergunta por localhost:3001
(sem-tls-publico) {
	@tls path /api/dominios/tls
	respond @tls 404
}

# ruphus.site e {slug}.ruphus.site atrás da Cloudflare (laranja, SSL Full Strict),
# com o Origin Certificate wildcard emitido no painel da Cloudflare
ruphus.site, *.ruphus.site {
	tls /etc/caddy/origin-ruphus.pem /etc/caddy/origin-ruphus.key
	encode gzip
	route {
		import sem-tls-publico
		import ip-real
	}
}

# domínio próprio de cliente (DNS direto no IP da VPS, sem Cloudflare)
https:// {
	tls {
		on_demand
	}
	encode gzip
	route {
		import sem-tls-publico
		import ip-real
	}
}
