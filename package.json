    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.4.4",
    "nodemailer": "^10.1.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
