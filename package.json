    "test:ia": "tsx --conditions=react-server ia.test.mts",
    "test:foto-rota": "tsx --conditions=react-server foto-rota.test.mts",
    "test:coleta": "tsx coleta.test.mts",
    "test:lembrete": "tsx lembrete.test.mts",
