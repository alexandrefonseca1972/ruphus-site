{
  "name": "siteflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:sites": "tsx --env-file=.env.local scripts/import-sites.mts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-siteflow 'node rules.test.mjs'",
    "test:booking": "firebase emulators:exec --only firestore,auth --project demo-siteflow 'tsx --conditions=react-server booking.test.mts'",
    "test:scale": "firebase emulators:exec --only firestore --project demo-siteflow 'tsx --conditions=react-server scale.test.mts'",
    "test:proxy": "tsx proxy.test.mts",
    "vitrine": "tsx scripts/vitrine.mts",
    "sync:sites": "sh scripts/sync-sites.sh",
    "seed:agenda": "tsx --env-file=.env.local scripts/seed-agenda.mts",
    "convite": "tsx --conditions=react-server --env-file=.env.local scripts/convite.mts",
    "admin": "tsx --env-file=.env.local scripts/admin-plataforma.mts",
    "test:convite": "firebase emulators:exec --only firestore --project demo-siteflow 'tsx --conditions=react-server convite.test.mts'",
    "test:cobranca": "firebase emulators:exec --only firestore --project demo-siteflow 'tsx --conditions=react-server cobranca.test.mts'",
    "test:clientes": "tsx --conditions=react-server clientes.test.mts",
    "test:crm": "tsx --conditions=react-server crm.test.mts",
    "test:pix": "tsx pix.test.mts",
    "test:whatsapp": "tsx whatsapp.test.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
