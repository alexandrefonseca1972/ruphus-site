    "test:sinal": "firebase emulators:exec --only firestore --project demo-siteflow 'tsx --conditions=react-server sinal.test.mts'",
    "test:sinal-puro": "tsx sinal-puro.test.mts",
    "test:conexao": "tsx conexao.test.mts",
    "test:coleta-tempo": "tsx coleta-tempo.test.mts",
    "test:coleta-selecao": "tsx coleta-selecao.test.mts",
    "test:mensagens": "tsx mensagens.test.mts",
    "canal-oficial": "tsx --conditions=react-server --env-file=.env.local scripts/canal-oficial.mts",
    "test:canal-oficial": "tsx --conditions=react-server canal-oficial.test.mts"
